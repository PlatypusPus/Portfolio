---
import Layout from "../layouts/Layout.astro";
import Rails from "../components/Rails.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { PROJECTS } from "../data/projects";

// Static content — prerender to the edge instead of running the Worker. The
// `curl` terminal render is only wired to `/`, so nothing here needs middleware.
export const prerender = true;
---

<Layout
  title="Projects — Shovin Jeson Dsouza"
  description="Things I've actually built, with the repos and live demos to poke at. A browser-based retinal disease classifier, an experimental real-time chat app."
>
  <Rails tag="[ WORK ]" file="~/portfolio/projects.astro" />
  <section class="hero">
    <div class="panel">
      <span class="corner tl"></span>
      <span class="corner tr"></span>
      <span class="corner bl"></span>
      <span class="corner br"></span>
      <span class="panel-label">~/projects</span>

      <p class="cmd">$ ls ~/projects</p>
      <h1 class="page-title">projects</h1>

      <div class="grid">
        {PROJECTS.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 32px 0; }

  .cmd {
    font-size: var(--fs-body);
    color: var(--text-dim);
    margin-bottom: 14px;
  }
  .page-title {
    font-family: "Press Start 2P", monospace;
    font-size: var(--fs-title);
    font-weight: 400;
    line-height: 1.4;
    color: var(--green);
    margin-bottom: 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 18px;
  }
</style>
