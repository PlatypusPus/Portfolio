---
import { themeCss } from "../tokens";
import Terminal from "../components/Terminal.astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { IDENTITY, CONTACT, STACK, EDUCATION } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a share image. Defaults to the site card. */
  image?: string;
  /** Keep a page out of search results. Only the 404 wants this. */
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  "I'm a 4th-year CS student at SJEC, Mangalore. I self-host my own infrastructure, run Linux and Gitea workshops, and build things mostly for the fun of it.";

const {
  title = `${IDENTITY.name} — CS student and self-hoster`,
  description = DEFAULT_DESCRIPTION,
  image = "/og.png",
  noindex = false,
} = Astro.props;

// Astro.site is set in astro.config.mjs; falling back to the request origin keeps
// this correct on preview deployments and in dev.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(image, origin);

// Structured data, built from the same profile.ts every other surface reads, so
// what Google is told can never drift from what the page says. `sameAs` is the
// part that actually matters: it ties this domain to the GitHub and LinkedIn
// profiles, which is how a search engine works out that they are one person.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: IDENTITY.name,
  alternateName: IDENTITY.handle,
  url: origin.href,
  image: ogImage.href,
  email: `mailto:${CONTACT.email}`,
  jobTitle: "Computer Science student",
  description: DEFAULT_DESCRIPTION,
  alumniOf: { "@type": "CollegeOrUniversity", name: EDUCATION[0].place },
  knowsAbout: STACK.flatMap((row) => row.items),
  sameAs: [CONTACT.github.url, CONTACT.linkedin.url],
};

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const NAV = [
  { href: "/", label: "home" },
  { href: "/about", label: "about" },
  { href: "/projects", label: "projects" },
  { href: "/contact", label: "contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Both palettes, as one <style> ahead of everything else. This used to be a
        style attribute on <html>, which had to move: an inline style beats every
        selector, so [data-theme] could never have overridden it. */}
    <style is:inline set:html={themeCss}></style>
    {/* A GIF cannot carry two palettes the way an SVG could, so there is one
        per theme and the head script below swaps the href. Dark is the default,
        matching what a bare /favicon.ico request gets — that file still exists
        for anything asking for it directly, but it is deliberately not declared
        here: given the choice Chrome picks the .ico for a small tab and the GIF
        never appears. Firefox animates the bongo paws; Chrome and Safari show
        the first frame. */}
    <link rel="icon" id="favicon" href="/favicon-dark.gif" type="image/gif" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="shov.in" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shovin Jeson Dsouza" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-pixel" preload />
    <ClientRouter />

    <script is:inline>
      document.documentElement.classList.add("js");
      // The boot overlay is server-rendered on every page, so after a client-side
      // navigation it would flash back over the new page. Marking <html> before
      // paint keeps it hidden for the rest of the session.
      const markBooted = () => {
        try {
          if (sessionStorage.getItem("booted")) {
            document.documentElement.classList.add("booted");
          }
        } catch {}
      };
      markBooted();
      document.addEventListener("astro:after-swap", markBooted);

      // Theme. Three states: "dark", "light", and stored-nothing, which means
      // follow the OS — the stylesheet already does that through
      // prefers-color-scheme, so "follow the OS" is the absence of an attribute
      // rather than a value of its own.
      //
      // Applied here, in the head, before anything paints: a light-mode visitor
      // must never eat a black flash on the way in.
      const THEME_NAMES = { dark: "dark", light: "light", "": "system" };
      const nextTheme = (t) => (t === "" ? "light" : t === "light" ? "dark" : "");

      const readTheme = () => {
        try {
          const v = localStorage.getItem("theme");
          return v === "dark" || v === "light" ? v : "";
        } catch {
          return "";
        }
      };

      // Runs again after every client-side navigation: ClientRouter takes
      // <html>'s attributes from the incoming document, and the server has no
      // idea what this visitor picked.
      const applyTheme = () => {
        const theme = readTheme();
        const root = document.documentElement;
        if (theme) root.dataset.theme = theme;
        else delete root.dataset.theme;

        // Unlike the CSS, the icon cannot defer to prefers-color-scheme — it is
        // one file or the other — so "auto" has to resolve to a real theme here.
        const resolved =
          theme || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        const href = `/favicon-${resolved}.gif`;
        const icon = document.getElementById("favicon");
        if (icon && icon.getAttribute("href") !== href) {
          // Replaced, not re-pointed: Chrome caches the tab icon and ignores an
          // in-place href change, so setAttribute alone left the old one up.
          const next = document.createElement("link");
          next.id = "favicon";
          next.rel = "icon";
          next.type = "image/gif";
          next.setAttribute("sizes", "64x64");
          next.href = href;
          icon.remove();
          document.head.appendChild(next);
        }

        // The button's visible label is drawn by CSS off [data-theme], which
        // keeps it correct before this script has ever run. CSS content is not
        // reliably announced though, so the accessible name is set here.
        const btn = document.getElementById("theme-toggle");
        if (btn) {
          btn.setAttribute(
            "aria-label",
            "Theme: " + THEME_NAMES[theme] + ". Switch to " + THEME_NAMES[nextTheme(theme)] + ".",
          );
        }
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
      // The head runs before the button exists; this is the pass that labels it.
      document.addEventListener("DOMContentLoaded", applyTheme);

      // On "auto", the OS can flip underneath us; the CSS follows on its own but
      // the icon has to be told.
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", applyTheme);

      // Delegated, so it is bound once and survives every page swap.
      document.addEventListener("click", (e) => {
        const btn = e.target.closest && e.target.closest("#theme-toggle");
        if (!btn) return;
        const next = nextTheme(readTheme());
        try {
          if (next) localStorage.setItem("theme", next);
          else localStorage.removeItem("theme");
        } catch {}

        // The new theme wipes in from the button. View transitions snapshot the
        // old and new page and cross-fade them by default; clipping the new
        // snapshot to a circle growing out of the button turns that into a
        // wipe. Without support, or with reduced motion asked for, the theme
        // just changes — the swap is the feature, the animation is not.
        const motion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!document.startViewTransition || motion) return applyTheme();

        const r = btn.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        // far enough to reach whichever corner is furthest from the button
        const reach = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

        // Marks this transition as a theme swap rather than a navigation, so the
        // CRT collapse below stands down and the wipe is the only motion.
        const root = document.documentElement;
        root.dataset.vt = "theme";
        const vt = document.startViewTransition(applyTheme);
        vt.ready.then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${reach}px at ${x}px ${y}px)`] },
            {
              duration: 480,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        });
        vt.finished.finally(() => delete root.dataset.vt);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <div id="boot" class="boot" aria-hidden="true">
      <pre id="boot-log" class="boot-log"></pre>
      <span class="boot-skip">press any key / click to skip</span>
    </div>

    <nav class="navbar">
      <span class="corner tl"></span>
      <span class="corner tr"></span>
      <span class="corner bl"></span>
      <span class="corner br"></span>
      <span class="prompt">shovin@portfolio:~$</span>
      <div class="nav-links">
        {NAV.map((item) => (
          <a href={item.href} class:list={["nav-link", { active: path === item.href }]}>
            {item.label}
          </a>
        ))}
        {/* Label comes from CSS, keyed off [data-theme], so it is right on the
            first paint. The accessible name is set by the head script. */}
        <button type="button" id="theme-toggle" class="nav-link theme-toggle">
          <span class="theme-state" aria-hidden="true"></span>
        </button>
      </div>
    </nav>

    <main class="terminal-body" id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <span class="foot-line">
        <span class="foot-prompt">shovin@portfolio:~$</span>{" "}
        <span class="foot-cmd">exit</span>
      </span>
      <div class="foot-links">
        <span class="foot-copy">© {new Date().getFullYear()} Shovin Jeson Dsouza</span>
        <a href="/privacy">privacy</a>
      </div>
    </footer>

    <Terminal />

    <script>
      const boot = document.getElementById("boot");
      const log = document.getElementById("boot-log");

      // OK:  -> green [  OK  ] prefix · ""  -> blank line · plain -> header/login text
      const LINES = [
        "Arch Linux 6.7.0-arch1 (tty1)",
        "",
        "[    0.000000] Booting shov.in kernel ...",
        "OK:Started Load Kernel Modules.",
        "OK:Mounted /home/shovin.",
        "OK:Reached target Local File Systems.",
        "OK:Started Journal Service.",
        "OK:Started D-Bus System Message Bus.",
        "OK:Started Network Manager.",
        "OK:Reached target Network.",
        "OK:Started OpenSSH Daemon.",
        "OK:Started portfolio.service.",
        "OK:Started Display Manager.",
        "OK:Started Docker Application Container Engine.",
        "OK:Reached target Graphical Interface.",
        "",
        "Arch Linux 6.7.0-arch1 (tty1)",
        "",
        "shovin login: shovin",
        "Last login: " + new Date().toUTCString(),
        "Launching portfolio ...",
      ];

      function markUp(line) {
        if (line === "") return "";
        if (line.startsWith("OK:"))
          return '<span class="ok">[  OK  ]</span> ' + line.slice(3);
        return '<span class="head">' + line + "</span>";
      }

      function skip() {
        boot.classList.add("done");
        setTimeout(() => boot.remove(), 550);
      }

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const seen = sessionStorage.getItem("booted");

      if (reduced || seen) {
        boot.remove();
      } else {
        sessionStorage.setItem("booted", "1");
        let i = 0;
        const step = () => {
          if (i >= LINES.length) {
            setTimeout(skip, 450);
            return;
          }
          const line = LINES[i++];
          log.innerHTML += markUp(line) + "\n";
          // Reached-target lines feel like they "wait" a beat
          const delay = line.startsWith("OK:Reached") ? 160 : line === "" ? 90 : 50;
          timer = setTimeout(step, delay);
        };
        let timer = setTimeout(step, 200);
        const onSkip = () => {
          clearTimeout(timer);
          skip();
        };
        boot.addEventListener("click", onSkip, { once: true });
        addEventListener("keydown", onSkip, { once: true });
      }
    </script>

    <script>
      // Reveal panels as they scroll into view. This must re-run after every
      // client-side navigation: panels start at opacity 0, so a swapped-in page
      // whose panels were never observed would render blank.
      const revealPanels = () => {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" }
        );
        document.querySelectorAll(".panel").forEach((el) => io.observe(el));
      };
      // astro:page-load fires on the first load and after every navigation.
      document.addEventListener("astro:page-load", revealPanels);
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* The palette itself lives in src/tokens.ts and is emitted onto <html> as
     custom properties; about.astro reads the same object to draw its swatch row.
     Roles and contrast ratios are documented there. */
  :root {
    color-scheme: dark;

    /* Type scale — 1.25 between every step, anchored on a 1rem body.
       Replaces 20 ad-hoc sizes, 13 of which sat inside a single 1.6x range with
       steps as small as 0.32px: too close to read as hierarchy, far enough apart
       to read as inconsistency. Five roles is enough because face and colour
       already separate the rest — a Press Start 2P heading in green next to
       JetBrains Mono metadata in grey needs no size difference to be legible. */
    --fs-meta: 0.8rem; /*     12.8px · dates, periods, captions, labels, tags, rails */
    --fs-body: 1rem; /*       16px   · prose, nav, controls, inputs, command lines */
    --fs-lead: 1.25rem; /*    20px   · the hero bio */
    --fs-title: 1.55rem; /*   24.8px · page and section titles */
    --fs-display: 1.95rem; /* 31.2px · the name, once */

    /* Monospace makes every glyph full-width, so a comfortable measure is
       narrower here than in a proportional face. 1ch is exact in mono. */
    --measure: 68ch;
  }

  /* Press Start 2P ships a single weight. Any heading element using it inherits
     the UA's bold and gets a synthesised one, which smears the pixel grid that is
     the whole point of the face. Every consumer states 400 explicitly. */

  html {
    height: 100%;
    background-color: var(--bg);
  }

  /* One focus treatment for the whole site. Green reads as a terminal selection
     and matches the language already used for active nav and hover. */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ── Green text selection ── */
  ::selection {
    background: var(--accent);
    color: var(--bg);
    text-shadow: none;
  }

  /* ── Custom terminal cursor (whole viewport, incl. gutters) ──
     A url() cannot hold a var(), so the arrow's colours are baked into an SVG
     data URI — which means each theme needs its own copy of the whole cursor.
     tokens.ts generates both and hands them over as these two properties, so
     the pointer turns pink with everything else instead of staying green. */
  html, body {
    cursor: var(--cursor), auto;
  }
  a, button, [role="button"], .nav-link, summary, label {
    cursor: var(--cursor-pointer), pointer;
  }

  /* A touch device has no cursor to replace, so don't ship it one. CSS cannot
     detect an OS-enlarged or high-contrast pointer, which is why the !important
     that used to be on the rule above is gone: without it, a user stylesheet can
     still win. */
  @media (pointer: coarse) {
    html, body,
    a, button, [role="button"], .nav-link, summary, label {
      cursor: auto;
    }
  }

  /* ── Minimal scrollbar ── */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  /* ── Arch-style boot overlay ── */
  .boot {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg);
    padding: clamp(20px, 5vw, 36px) clamp(16px, 6vw, 44px);
    overflow: hidden;
    /* Failsafe. This element covers the entire viewport and is removed by a
       bundled module script. If that script 404s, fails to parse, or throws, the
       overlay would sit over every page forever and the site would be a black
       rectangle. The animation runs to completion on its own and JS normally
       beats it by ~3s, so it only ever fires when JS did not. */
    animation: boot-failsafe 0.4s linear 6s forwards;
  }
  /* JS disabled entirely: never show it at all. The .js class is set by an inline
     head script, which is far more robust than the bundled module. */
  html:not(.js) .boot { display: none; }
  /* Already booted this session: never show it again, including after a
     client-side navigation re-renders it. */
  html.booted .boot { display: none; }
  .boot.done {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  @keyframes boot-failsafe {
    to { opacity: 0; visibility: hidden; }
  }

  /* ── Skip link ── */
  /* Clipped rather than translated off the top edge. A translated element is
     still painted, and mobile browsers position fixed elements against the
     layout viewport, so a pinch-zoom pan or an overscroll bounce pulled this
     back into frame. At 1px and clipped there is nothing to pull.
     :focus, not :focus-visible - a screen reader moving focus here has to see
     it, and that is the user this link exists for. */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip-link:focus {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    width: auto;
    height: auto;
    clip-path: none;
    padding: 12px 18px;
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-body);
    text-decoration: none;
    border-radius: 0 0 6px 0;
  }
  #main:focus { outline: none; }
  .boot-log {
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }
  .boot-log .ok   { color: var(--accent); }
  .boot-log .head { color: var(--text-bright); }
  .boot-skip {
    position: fixed;
    bottom: 28px;
    right: 36px;
    font-size: var(--fs-meta);
    color: var(--text-dim);
  }

  body {
    font-family: var(--font-mono);
    /* rem, not px — a hard 16px ignores a raised browser default font size */
    font-size: var(--fs-body);
    /* light-on-dark blooms and closes up counters; a hair of tracking opens it */
    letter-spacing: 0.01em;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    max-width: 1080px;
    margin: 0 auto;
    /* Fluid gutters. A flat 40px left a 148px reading column on a 360px phone
       once the panel took its own 60px on each side. */
    padding: 0 clamp(16px, 4vw, 40px);
  }

  /* ── Navbar ── */
  .navbar {
    position: sticky;
    top: 12px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 10px 28px;
    margin-top: 24px;
    /* links carry their own 44px height now, so the bar needs less of its own */
    padding: 8px clamp(16px, 3vw, 28px);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    flex-wrap: wrap;
  }

  /* mask the 12px gap above the floating bar so content doesn't bleed through */
  .navbar::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
    background: var(--bg);
  }

  /* ── Framed panel + corner brackets (shared by navbar, hero, pages) ── */
  .panel {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 8px;
    /* Fluid, and global — the old flat 56px/60px was overridden only on the home
       page, so five routes kept desktop padding all the way down to 360px. */
    padding: clamp(28px, 5vw, 56px) clamp(20px, 5.5vw, 60px);
    /* Terminal grid backdrop. Anything boxed that sits on a panel — buttons,
       chips, tags — needs its own background or these lines run straight
       through it. Translucent hover tints on those need mixing, not layering,
       for the same reason. */
    background-image:
      linear-gradient(rgb(var(--accent-rgb) / var(--grid)) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / var(--grid)) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .panel-label {
    position: absolute;
    top: -0.6em;
    left: 32px;
    padding: 0 10px;
    background: var(--bg);
    color: var(--text-dim);
    font-size: var(--fs-meta);
    /* section panels render this as an <h2>, so cancel the UA's bold */
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--accent);
  }
  .corner.tl { top: -1px; left: -1px;  border-right: none; border-bottom: none; }
  .corner.tr { top: -1px; right: -1px; border-left: none;  border-bottom: none; }
  .corner.bl { bottom: -1px; left: -1px;  border-right: none; border-top: none; }
  .corner.br { bottom: -1px; right: -1px; border-left: none;  border-top: none; }

  /* ── Scroll-reveal (panels fade + slide up as they enter view) ── */
  html.js .panel {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  html.js .panel.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .panel,
    html.js .panel.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .prompt {
    color: var(--accent);
    font-size: var(--fs-body);
  }

  /* This row was the site-wide horizontal scroll: the bar wrapped, the links
     inside it did not, so five links held one unbreakable 421px line. */
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-left: auto;
  }

  /* Padding buys a 45x50 tap target — "home" rendered 38x21 before. No negative
     margin to claw the height back: once the row wraps, that would overlap each
     row's tap area into the one below it and make taps near the seam a coin toss. */
  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 6px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: var(--fs-body);
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link.active { color: var(--accent); }

  .theme-toggle {
    background: none;
    border: 0;
    font: inherit;
    color: var(--text-dim);
    /* the links pad 12px 6px; match, minus what the brackets already add */
    padding: 12px 4px;
  }
  .theme-toggle:hover { color: var(--accent); }
  /* No stored choice: following the OS, whichever way that points. */
  .theme-state::after { content: "[auto]"; }
  :root[data-theme="dark"] .theme-state::after { content: "[dark]"; }
  :root[data-theme="light"] .theme-state::after { content: "[light]"; }

  /* ── Body ── */
  .terminal-body {
    padding: 40px 0;
  }

  /* Page transitions: the screen collapses to a line and the next one opens,
     like a CRT powering down and back up.

     This animates `root`, not the content column. The column is up to 5x the
     viewport height, so its snapshot is a single very tall image whose centre
     sits far off-screen once you have scrolled down; scaling that made the page
     fly away instead of folding shut, and it looked different depending on how
     far down you were. The root snapshot is always exactly viewport-sized, so
     the collapse lands the same way from any scroll position. */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      transform-origin: center center;
      /* the UA cross-fades these with plus-lighter, which washes out to white
         while both layers are mid-collapse */
      mix-blend-mode: normal;
    }
    ::view-transition-old(root) {
      animation: crt-off 200ms cubic-bezier(0.4, 0, 1, 1) both;
    }
    ::view-transition-new(root) {
      animation: crt-on 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 90ms;
    }

    /* A theme swap is not a navigation. The CRT collapse would fight the wipe
       the toggle drives, so it stands down for that one case: the old page
       simply holds still underneath while the new one is clipped in over it. */
    :root[data-vt="theme"]::view-transition-old(root),
    :root[data-vt="theme"]::view-transition-new(root) {
      animation: none;
    }
  }
  @keyframes crt-off {
    0%   { opacity: 1; transform: scaleY(1) scaleX(1); }
    70%  { opacity: 1; transform: scaleY(0.012) scaleX(1); }
    100% { opacity: 0; transform: scaleY(0.012) scaleX(0.45); }
  }
  @keyframes crt-on {
    0%   { opacity: 0; transform: scaleY(0.012) scaleX(0.45); }
    30%  { opacity: 1; transform: scaleY(0.012) scaleX(1); }
    100% { opacity: 1; transform: scaleY(1) scaleX(1); }
  }

