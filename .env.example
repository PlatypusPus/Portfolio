# Contact form (src/pages/api/contact.ts). Local dev reads these from .dev.vars;
# production reads them from Cloudflare Worker secrets (`wrangler secret put ...`).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Verified sender domain in Resend. Falls back to Resend's shared
# onboarding@resend.dev address if unset.
CONTACT_FROM=shov.in <hello@shov.in>
