# Everything under /_astro/ has a content hash in its filename, so a change
# produces a new URL. That makes these safe to cache permanently — without this
# a repeat visitor revalidates the CSS, JS, fonts and images on every page load.
#
# HTML is deliberately not listed: src/middleware.ts sets its own Cache-Control
# so a new deploy is picked up immediately.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed (it lives in public/), so cache it for a week rather than
# forever. Rename the file if you ever swap the photo.
/shovin.webp
  Cache-Control: public, max-age=604800

# The bongo cat. Content-hashed names would be better, but these have to sit at
# fixed paths for the browser to find them, so a week is the compromise.
/favicon-dark.gif
  cache-control: public, max-age=604800
/favicon-light.gif
  cache-control: public, max-age=604800
/favicon.ico
  cache-control: public, max-age=604800
/apple-touch-icon.png
  cache-control: public, max-age=604800
